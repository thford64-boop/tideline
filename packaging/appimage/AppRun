#!/bin/sh
# Start Tideline from inside its AppImage: everything it needs (Python, GTK 4,
# libadwaita, MLT, FFmpeg, frei0r, Qt for titles) is under $APPDIR/usr.
# The host's graphics drivers, X11/Wayland, audio server and fonts are used.
set -e
APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
export APPDIR
U="$APPDIR/usr"

# Remember what the session had, so Tideline can hand the original values to
# the programs it starts (see tideline/appimage.py).
for name in LD_LIBRARY_PATH GDK_PIXBUF_MODULE_FILE GDK_PIXBUF_MODULEDIR GSETTINGS_SCHEMA_DIR \
            GIO_MODULE_DIR XDG_DATA_DIRS GI_TYPELIB_PATH PYTHONNOUSERSITE; do
    if eval "[ \"\${$name+set}\" = set ]"; then
        eval "export TIDELINE_HOST_$name=\"\$$name\""
    else
        export "TIDELINE_HOST_$name=@unset@"
    fi
done

export TIDELINE_APPIMAGE=1
export LD_LIBRARY_PATH="$U/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GI_TYPELIB_PATH="$U/lib/girepository-1.0"
export GSETTINGS_SCHEMA_DIR="$U/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$U/lib/gio/modules"
export XDG_DATA_DIRS="$U/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export MLT_REPOSITORY="$U/lib/mlt-7"
export MLT_DATA="$U/share/mlt-7"
export MLT_PROFILES_PATH="$U/share/mlt-7/profiles"
export MLT_PRESETS_PATH="$U/share/mlt-7/presets"
export FREI0R_PATH="$U/lib/frei0r-1"
export PATH="$U/tools:$PATH"
export PYTHONNOUSERSITE=1
# The bundled libva looks for the host's drivers in the usual places of the
# common distributions, unless told otherwise.
if [ -z "${LIBVA_DRIVERS_PATH:-}" ]; then
    export LIBVA_DRIVERS_PATH="/usr/lib/x86_64-linux-gnu/dri:/usr/lib64/dri:/usr/lib/dri:/usr/lib/x86_64-linux-gnu/dri-nonfree:/run/opengl-driver/lib/dri"
fi

# GdkPixbuf needs a list of its image loaders with absolute paths.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/tideline"
mkdir -p "$cache_dir" 2>/dev/null || cache_dir="${TMPDIR:-/tmp}"
loaders="$U/lib/gdk-pixbuf-2.0/2.10.0/loaders"
export GDK_PIXBUF_MODULEDIR="$loaders"
export GDK_PIXBUF_MODULE_FILE="$cache_dir/appimage-pixbuf-loaders.cache"
"$U/libexec/tideline/gdk-pixbuf-query-loaders" "$loaders"/*.so > "$GDK_PIXBUF_MODULE_FILE" 2>/dev/null || true

# Bundled helpers: `AppRun melt …`, `AppRun ffmpeg …`, `AppRun ffprobe …`.
case "${1:-}" in
    melt|ffmpeg|ffprobe) tool="$1"; shift; exec "$U/tools/$tool" "$@" ;;
esac

exec "$U/bin/python3" -I -m tideline "$@"
