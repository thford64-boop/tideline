<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-tideline-project">
    <comment>Tideline project</comment>
    <glob pattern="*.tideline"/>
    <sub-class-of type="application/json"/>
  </mime-type>
  <mime-type type="application/x-tideline-preset">
    <comment>Tideline effect preset</comment>
    <glob pattern="*.tlpreset"/>
    <sub-class-of type="application/json"/>
  </mime-type>
</mime-info>
